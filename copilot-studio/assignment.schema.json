{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "curbside-assignment",
  "title": "A run, as read from dispatch's assignment sheet",
  "description": "What public/importer/sheet.js returns (buildAssignment). Times are New York wall clock. A field the sheet does not give is null or absent: never guessed. See reading-the-sheet.md.",
  "type": "object",
  "required": ["number", "start", "end", "steps", "assistants", "gb", "issues"],
  "additionalProperties": false,
  "properties": {
    "number": { "type": "string", "pattern": "^[0-9]+$", "description": "The assignment number: the run's identity." },
    "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$", "description": "Dispatch's leave time, YYYY-MM-DD HH:MM, 24-hour." },
    "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$", "description": "Back at the start site." },
    "driver": { "type": ["string", "null"], "description": "As printed, Last, First." },
    "vehicle": { "type": ["string", "null"] },
    "parking": { "type": ["string", "null"] },
    "originCode": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "driverNotes": { "type": ["string", "null"] },
    "assistants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "role": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["place", "date", "etaDate", "actions"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": ["string", "null"], "pattern": "^[A-Z]{2,5}$" },
          "place": { "type": "string" },
          "address": { "type": ["string", "null"] },
          "eta": { "type": ["string", "null"], "pattern": "^\\d{1,2}:\\d{2}\\s*[AP]M$", "description": "As printed, e.g. 11:00 PM. Null on a first stop." },
          "etd": { "type": ["string", "null"], "pattern": "^\\d{1,2}:\\d{2}\\s*[AP]M$", "description": "Null on a last stop." },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The ETD's date, walked forward across midnight." },
          "etaDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The ETA's date." },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["verb", "entities"],
              "additionalProperties": false,
              "properties": {
                "verb": { "type": "string", "description": "Pickup or Drop-Off; not a closed set." },
                "where": { "type": ["string", "null"], "description": "The door; null when dispatch left it blank." },
                "entities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "pax"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string", "description": "Last, First; a party: Hauser, Marcus & Vera." },
                      "pax": { "type": "integer", "minimum": 1 },
                      "tag": { "type": ["string", "null"], "enum": ["A", "D", "GBA", "GBD", "MED", "S", "TD", "HO", null] },
                      "gb": { "type": "boolean" },
                      "origin": { "type": ["string", "null"] },
                      "destination": { "type": ["string", "null"] },
                      "phone": { "type": ["string", "null"] },
                      "otherPhones": { "type": "array", "items": { "type": "string" } },
                      "bags": { "type": ["integer", "null"], "minimum": 0 },
                      "note": { "type": ["string", "null"] },
                      "flightNumber": { "type": ["string", "null"], "pattern": "^[A-Z0-9]{2,3}\\d{1,4}[A-Z]?$", "description": "Null when it cannot be resolved: never guessed." },
                      "scheduledText": { "type": ["string", "null"], "description": "The Time/City cell: 11:15 PM Houston, Texas (IAH)." },
                      "flightDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The day the flight operates at its airport." },
                      "unknownAirline": {
                        "type": ["object", "null"],
                        "required": ["name", "number"],
                        "additionalProperties": false,
                        "properties": {
                          "name": { "type": "string" },
                          "number": { "type": "string" },
                          "date": { "type": ["string", "null"] }
                        }
                      },
                      "appointmentTime": { "type": ["string", "null"] },
                      "duration": { "type": ["string", "null"] },
                      "route": { "type": ["string", "null"] },
                      "unsupported": { "type": ["string", "null"], "enum": ["train", "embassy/consulate", null] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gb": { "type": "boolean", "description": "Any row tagged GBA or GBD." },
    "issues": { "type": "array", "items": { "type": "string" }, "description": "What could not be read, in words." },
    "printedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$", "description": "The footer's print time: decides which copy wins." },
    "source": { "type": ["string", "null"], "description": "The file's name." }
  }
}
